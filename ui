-- Rainbow Title "CURRYV4" (Hardcoded Specific Colors)
local titleText = "CURRYV4"
local container = Instance.new("Frame")
container.Size = UDim2.new(1, 0, 0, 50)
container.Position = UDim2.new(0, 0, 0, 10)
container.BackgroundTransparency = 1
container.Parent = MainFrame

-- Exact colors for each letter to match the image
local letterColors = {
    Color3.fromRGB(255, 0, 0),       -- C (Red)
    Color3.fromRGB(255, 100, 0),     -- U (Orange)
    Color3.fromRGB(255, 255, 0),     -- R (Yellow)
    Color3.fromRGB(0, 255, 0),       -- R (Green)
    Color3.fromRGB(0, 100, 255),     -- Y (Blue)
    Color3.fromRGB(75, 0, 130),      -- V (Indigo)
    Color3.fromRGB(255, 0, 255)      -- 4 (Magenta)
}

for i = 1, #titleText do
    local char = string.sub(titleText, i, i)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 40, 0, 50)
    label.Position = UDim2.new(0, (i-1)*40 + 20, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = char
    label.Font = Enum.Font.GothamBold
    label.TextSize = 35
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    
    -- Assign the specific hardcoded color
    if letterColors[i] then
        label.TextColor3 = letterColors[i]
    else
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
    
    label.Parent = container
end

