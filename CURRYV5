-- --- LOGIC ---
local isTesting = false
local connection = nil

-- NOTE: You MUST replace this with a valid RemoteEvent name from the specific game
-- Most games do not expose vulnerable remotes to the client.
local function getTargetRemote()
    -- Example: Look for a common name, but this will likely be nil in most games
    return ReplicatedStorage:FindFirstChild("BuyItem") -- Common in Bedwars, but protected
end

local function startTest()
    if isTesting then return end
    isTesting = false -- Ensure we don't start twice
    
    -- Warning: This will likely get you kicked if the remote is protected or rate-limited
    StatusLabel.Text = "Status: Attempting to start..."
    
    local target = getTargetRemote()
    if not target then
        StatusLabel.Text = "Status: No valid RemoteEvent found. Test aborted."
        return
    end
    
    if not target:IsA("RemoteEvent") then
        StatusLabel.Text = "Status: Target is not a RemoteEvent. Aborted."
        return
    end

    isTesting = true
    StatusLabel.Text = "Status: Running Test (Risk of Kick)..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 165, 0)
    
    local startTime = os.clock()
    local packetCount = 0
    
    connection = RunService.Heartbeat:Connect(function()
        if not isTesting or (os.clock() - startTime) > TEST_DURATION then
            isTesting = false
            if connection then connection:Disconnect() end
            StatusLabel.Text = "Status: Test Complete / Stopped."
            StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
            return
        end
        
        -- Attempt to fire the remote
        local success, err = pcall(function()
            target:FireServer("TEST_DATA")
        end)
        
        packetCount = packetCount + 1
        StatusLabel.Text = string.format("Status: Running (Sent: %d)", packetCount)
        
        if not success then
            -- If FireServer fails (e.g., rate limit or security kick), stop immediately
            isTesting = false
            StatusLabel.Text = "Status: Failed (Server rejected request). Stopping."
            if connection then connection:Disconnect() end
        end
    end)
end

local function stopTest()
    if not isTesting then return end
    isTesting = false
    if connection then connection:Disconnect() end
    StatusLabel.Text = "Status: Force Stopped by User."
    StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
end

-- Fixed: Properly connect the buttons
StartBtn.MouseButton1Click:Connect(function()
    if not isTesting then
