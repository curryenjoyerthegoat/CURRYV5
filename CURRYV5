-- Create Tab Buttons
local function createTabButton(category, index)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.Position = UDim2.new(0, 0, 0, (index-1)*35 + 5)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30) -- Black/Dark Gray
    btn.TextColor3 = Color3.fromRGB(255, 255, 255) -- White Text
    btn.Text = category.name
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.Parent = tabContainer

    btn.MouseButton1Click:Connect(function()
        -- Clear content area
        for _, child in pairs(contentArea:GetChildren()) do
            if child:IsA("Frame") then
                child:Destroy()
            end
        end
        
        -- Create module buttons for selected category
        for i, moduleName in ipairs(category.modules) do
            local moduleBtn = Instance.new("TextButton")
            moduleBtn.Size = UDim2.new(1, -20, 0, 30)
            moduleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40) -- Black Button
            moduleBtn.TextColor3 = Color3.fromRGB(255, 255, 255) -- White Text
            moduleBtn.Text = moduleName
            moduleBtn.Font = Enum.Font.GothamBold
            moduleBtn.TextSize = 14
            moduleBtn.Parent = contentArea
            
            moduleBtn.MouseButton1Click:Connect(function()
                -- Toggle visual state only
                if moduleBtn.BackgroundColor3 == Color3.fromRGB(40, 40, 40) then
                    moduleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                else
                    moduleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                end
            end)
        end
    end)
    
    tabButtons[index] = btn
end

-- Initialize Tabs
for i, category in ipairs(categories) do
    createTabButton(category, i)
end

-- Open first tab by default
if #categories > 0 then
    tabButtons[1].MouseButton1Click:Invoke()
end
