-- Rainbow Title "CURRYV4"
local TitleFrame = Instance.new("Frame")
TitleFrame.Size = UDim2.new(1, 0, 0, 60)
TitleFrame.BackgroundTransparency = 1
TitleFrame.Parent = MainFrame

local titleText = "CURRYV4"
local charWidth = 28 -- Approximate width per character
local startX = (350 - (charWidth * len(titleText))) / 2 + 10 -- Centering calculation

-- Create individual rainbow letters
for i = 1, len(titleText) do
    local char = string.sub(titleText, i, i)
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0, 30, 0, 40)
    Label.Position = UDim2.new(0, 40 + (i-1)*45, 0, 10) -- Spaced out
    Label.BackgroundTransparency = 1
    Label.Text = char
    Label.Font = Enum.Font.GothamBold
    Label.TextSize = 32
    Label.TextStrokeTransparency = 0
    
    -- Rainbow colors
    local hue = (i - 1) / 7
    Label.TextColor3 = Color3.fromHSV(hue, 1, 1)
    
    Label.Parent = TitleFrame
end

