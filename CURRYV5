tabContainer.Position = UDim2.new(0, 10, 0, 60)
tabContainer.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
tabContainer.Parent = MainFrame

local contentArea = Instance.new("ScrollingFrame")
contentArea.Size = UDim2.new(1, -170, 1, -70)
contentArea.Position = UDim2.new(0, 170, 0, 60)
contentArea.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
contentArea.CanvasSize = UDim2.new(0, 0, 0, 0)
contentArea.ScrollBarThickness = 8
contentArea.ScrollBarImageColor3 = Color3.fromRGB(50, 50, 50)
contentArea.Parent = MainFrame

local contentLayout = Instance.new("UIListLayout")
contentLayout.Padding = UDim.new(0, 5)
contentLayout.Parent = contentArea

local function updateCanvasSize()
    contentArea.CanvasSize = UDim2.new(0, 0, 0, contentLayout.AbsoluteContentSize.Y)
end

contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvasSize)

local function createTabButton(category, index)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.Position = UDim2.new(0, 0, 0, (index-1)*35 + 5)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = category.name
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.Parent = tabContainer

    btn.MouseButton1Click:Connect(function()
        for _, child in pairs(contentArea:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end
        
        for i, moduleName in ipairs(category.modules) do
            local moduleBtn = Instance.new("TextButton")
            moduleBtn.Size = UDim2.new(1, -20, 0, 30)
            moduleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            moduleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            moduleBtn.Text = moduleName
            moduleBtn.Font = Enum.Font.GothamBold
            moduleBtn.TextSize = 14
            moduleBtn.Parent = contentArea
            
            moduleBtn.MouseButton1Click:Connect(function()
                moduleBtn.BackgroundColor3 = moduleBtn.BackgroundColor3 == Color3.fromRGB(40, 40, 40) and Color3.fromRGB(60, 60, 60) or Color3.fromRGB(40, 40, 40)
            end)
        end
    end)
end

for i, category in ipairs(categories) do
    createTabButton(category, i)
end

