-- Rainbow Title "CURRYV4"
local titleContainer = Instance.new("Frame")
titleContainer.Size = UDim2.new(0, 200, 0, 50)
titleContainer.Position = UDim2.new(0, 20, 0, 10)
titleContainer.BackgroundTransparency = 1
titleContainer.Parent = MainFrame

local titleText = "CURRYV4"
local colors = {
    Color3.fromRGB(255, 0, 0),       
    Color3.fromRGB(255, 100, 0),     
    Color3.fromRGB(255, 255, 0),     
    Color3.fromRGB(0, 255, 0),       
    Color3.fromRGB(0, 100, 255),     
    Color3.fromRGB(75, 0, 130),      
    Color3.fromRGB(255, 0, 255)      
}

for i = 1, #titleText do
    local char = string.sub(titleText, i, i)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 25, 0, 50)
    label.Position = UDim2.new(0, (i-1)*25, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = char
    label.Font = Enum.Font.GothamBold
    label.TextSize = 24
    label.TextColor3 = colors[i] or Color3.fromRGB(255, 255, 255)
    label.Parent = titleContainer
end

-- Categories
local categories = {
    {name = "Combat", modules = {"AimAssist", "AutoClicker", "Reach", "SilentAim", "Sprint", "TriggerBot"}},
    {name = "Blatant", modules = {"AntiFall", "Fly", "HighJump", "HitBoxes", "Invisible", "KillAura", "LongJump", "MouseTP", "Phase", "Speed", "Spider", "SpinBot", "TargetStrafe"}},
    {name = "Render", modules = {"Arrows", "Chams", "ESP", "GamingChair", "Health", "NameTags", "PlayerModel", "Search", "Tracers", "Waypoints"}},
    {name = "Utility", modules = {"AnimationPlayer", "AntiRagdoll", "AutoRejoin", "Blink", "ChatSpammer", "Disabler", "Panic", "Rejoin", "StaffDetector"}},
    {name = "World", modules = {"Anti-AFK", "Freecam", "Gravity", "Parkour", "SafeWalk", "Xray"}}
}

-- Tab System
local tabContainer = Instance.new("Frame")
tabContainer.Size = UDim2.new(0, 150, 1, -60)
tabContainer.Position = UDim2.new(0, 10, 0, 60)
tabContainer.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
tabContainer.Parent = MainFrame

local tabCorner = Instance.new("UICorner")
tabCorner.CornerRadius = UDim.new(0, 5)
tabCorner.Parent = tabContainer

local contentArea = Instance.new("ScrollingFrame")
contentArea.Size = UDim2.new(1, -170, 1, -70)
contentArea.Position = UDim2.new(0, 170, 0, 60)
contentArea.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
contentArea.CanvasSize = UDim2.new(0, 0, 0, 0)
contentArea.ScrollBarThickness = 8
contentArea.ScrollBarImageColor3 = Color3.fromRGB(50, 50, 50)
contentArea.Parent = MainFrame

local contentCorner = Instance.new("UICorner")
contentCorner.CornerRadius = UDim.new(0, 5)
contentCorner.Parent = contentArea

local contentLayout = Instance.new("UIListLayout")
contentLayout.Padding = UDim.new(0, 5)
contentLayout.Parent = contentArea

local function updateCanvasSize()
    contentArea.CanvasSize = UDim2.new(0, 0, 0, contentLayout.AbsoluteContentSize.Y)
end

contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvasSize)

local function createTabButton(category, index)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.Position = UDim2.new(0, 0, 0, (index-1)*35 + 5)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = category.name
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.Parent = tabContainer

    btn.MouseButton1Click:Connect(function()
        for _, child in pairs(contentArea:GetChildren()) do
            if child:IsA("Frame") then
                child:Destroy()
            end
        end
        
        for i, moduleName in ipairs(category.modules) do
            local moduleBtn = Instance.new("TextButton")
            moduleBtn.Size = UDim2.new(1, -20, 0, 30)
            moduleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            moduleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            moduleBtn.Text = moduleName
            moduleBtn.Font = Enum.Font.GothamBold
            moduleBtn.TextSize = 14
            moduleBtn.Parent = contentArea
            
            moduleBtn.MouseButton1Click:Connect(function()
                if moduleBtn.BackgroundColor3 == Color3.fromRGB(40, 40, 40) then
                    moduleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                else
                    moduleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                end
            end)
        end
    end)
end

for i, category in ipairs(categories) do
    createTabButton(category, i)
end

-- Toggle Function
local function toggleMenu()
    MainFrame.Visible = not MainFrame.Visible
end

-- Keybind Setup
if UserInputService then
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        if input.KeyCode == Enum.KeyCode.Insert then
            toggleMenu()
        end
    end
    print("CURRYV4 Loaded. Press INSERT key to open/close the menu.")
else
    -- If keybinds don't work, make menu visible by default so user can at least see it
    MainFrame.Visible = true
    warn("Keybinds not supported. Menu is visible by default. Press X to close.")
end
