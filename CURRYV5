-- CURRYV4 UI - GUARANTEED WORKING VERSION
-- Press INSERT key to Open/Close the menu

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

-- Check if executor supports UserInputService
local UserInputService = nil
local success, result = pcall(function()
    UserInputService = game:GetService("UserInputService")
    if not UserInputService then
        error("UserInputService not available")
    end
end)

if not success then
    warn("Keybinds not supported on this executor. Menu will be visible by default.")
end

-- Cleanup existing GUI
local existingGui = PlayerGui:FindFirstChild("CURRYV4_Menu")
if existingGui then 
    existingGui:Destroy()
    warn("Removed existing CURRYV4 Menu")
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "CURRYV4_Menu"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

